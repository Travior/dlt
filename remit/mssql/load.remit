context mssql_load
  layer  destination
  intent "Connect the mssql, synapse and fabric job clients and load files into tables"

concept TableSchema   "a prepared dlt table schema, including its requested file_format"
concept LoaderFormats "preferred and supported loader file formats for one table"
  state probed
    parquet_needs_pyarrow: parquet is offered only if pyarrow imports; insert_values stays preferred
concept ParquetFile   "a parquet load job file, read one row group at a time"

exposes does mssql_connect
  intent  "PyOdbcMsSqlClient.open_connection for the mssql and synapse destinations"
  takes   creds: mssql_config.MsSqlCredentials@resolved, timeout: mssql_client.ConnectionTimeout
  gives   mssql_client.Connection@ready
  fails   UnsupportedConnectionKeyword, DatabaseTransientException, DatabaseTerminalException
  steps
    mssql_config.mssql_to_odbc_dsn    creds                  -> dsn
    mssql_config.mssql_token_provider creds                  -> provider
    mssql_client.open_connection      dsn, timeout, provider -> mssql_client.Connection@ready

exposes does fabric_connect
  intent  "FabricSqlClient.open_connection: the same client, given FabricCredentials it duck-types as MsSqlCredentials"
  takes   creds: mssql_config.FabricCredentials@resolved, timeout: mssql_client.ConnectionTimeout
  gives   mssql_client.Connection@ready
  fails   UnsupportedConnectionKeyword, DatabaseTransientException, DatabaseTerminalException
  steps
    mssql_config.fabric_to_odbc_dsn    creds                  -> dsn
    mssql_config.fabric_token_provider creds                  -> provider
    mssql_client.open_connection       dsn, timeout, provider -> mssql_client.Connection@ready

exposes does select_mssql_loader_formats
  intent  "loader_file_format_selector of mssql: offer parquet when pyarrow is installed"
  takes   table: TableSchema
  gives   LoaderFormats@probed
  effects none
  because "mssql-python always ships bulkcopy_arrow; parquet is offered, not preferred, so json sources keep loading with insert_values"

exposes does load_parquet_file
  intent  "MssqlParquetCopyJob: append a parquet file with bulk copy over the job client's connection"
  takes   conn: mssql_client.Connection@ready, file: ParquetFile
  gives   mssql_client.CopiedRows@atomic
  fails   mssql_client.DatabaseTransientException, mssql_client.DatabaseTerminalException
  steps
    stream_parquet_file file         -> stream
    bulk_copy_arrow     conn, stream -> mssql_client.CopiedRows@atomic

does stream_parquet_file
  intent  "a RecordBatchReader over ParquetFile.iter_batches, so peak memory stays one batch"
  takes   ParquetFile
  gives   mssql_client.ArrowStream
